{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "control-plane",
  "version": "0.1.0",
  "identifier": "app.control-plane.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": {
      "script": "npm run stage",
      "wait": true
    },
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "connect-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Dashboard local para orquestar sesiones de Claude Code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server-bundle/": "app/"
    }
  }
}
